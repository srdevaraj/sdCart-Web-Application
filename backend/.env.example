# ============================================================================
# sdCart Backend — environment variable template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# All values below are examples / placeholders, not real credentials.
# ============================================================================

# --- PostgreSQL ------------------------------------------------------------
DATABASE_URL=jdbc:postgresql://localhost:5432/sdcart
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=password

# --- JWT (REQUIRED in production — use a long random string, >= 32 chars) --
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_ACCESS_EXPIRATION=900000        # 15 minutes, in milliseconds
JWT_REFRESH_EXPIRATION=604800000    # 7 days, in milliseconds

# --- Application -----------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
FRONTEND_URL=http://localhost:3000

# --- Abuse protection (per-IP fixed-window rate limit on /api/v1/auth/*) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30

# --- Admin bootstrap -------------------------------------------------------
# If ADMIN_PASSWORD is set (non-empty), an admin user with ADMIN_EMAIL is
# created automatically on startup when it does not exist yet.
ADMIN_EMAIL=admin@sdcart.com
ADMIN_PASSWORD=

# --- Cloudinary (optional — product image uploads) --------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payment (optional — mock gateway used when not configured) -------------
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (optional — console sink used when not configured) ---------------
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@sdcart.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
