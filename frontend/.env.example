# ============================================================================
# sdCart Frontend — environment variable template
# Copy to `.env` for LOCAL DEVELOPMENT. NEVER commit `.env` (it is gitignored).
# ============================================================================

# Base URL of the sdCart Spring Boot backend API (no /api/v1 suffix — the
# client appends it). Local development default.
VITE_API_BASE_URL=http://localhost:8080

# Public-facing origin used to build canonical/absolute links (optional).
VITE_APP_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# PRODUCTION (Docker / Render)
# Vite embeds env vars at BUILD TIME, so the API URL is injected when the
# image is built — it is never baked in and never comes from this file:
#
#   docker build --build-arg VITE_API_BASE_URL=https://sdcart-backend.onrender.com .
#
# Render: set VITE_API_BASE_URL on the sdcart-frontend web service (Render
# exposes service env vars as Docker build args automatically).
# ----------------------------------------------------------------------------
