# ============================================================================
# sdCart — Docker Compose environment template (copy to `.env`)
#
# ⚠️  These values are for LOCAL DEVELOPMENT ONLY.
# ⚠️  NEVER reuse `postgres/password` or the dev JWT secret in production.
#     Production (Render) generates its own credentials — see render.yaml and
#     README.md. Never commit `.env`.
# ============================================================================

# --- PostgreSQL (local container only) --------------------------------------
DATABASE_PASSWORD=password

# --- Backend ----------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
FRONTEND_URL=http://localhost:3000
JWT_SECRET=dev-only-secret-change-me-in-production-0123456789abcdef
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
ADMIN_EMAIL=admin@sdcart.com
ADMIN_PASSWORD=password

# --- Frontend (build arg injected by compose) --------------------------------
# The URL the BROWSER will call. For the local stack the backend is published
# on localhost:8080, so this stays a localhost value here.
VITE_API_BASE_URL=http://localhost:8080
